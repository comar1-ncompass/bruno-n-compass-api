meta {
  name: Upload Screenshot
  type: http
  seq: 1
}

post {
  url: {{local_base_url}}/pi/upload?licenseId={{test_license_id}}
  body: multipartForm
  auth: inherit
}

params:query {
  licenseId: {{test_license_id}}
}

body:multipart-form {
  file: @file(/D:/mikoo/Pictures/2024_12_17--14_09_11.png)
  ~file: @file(/D:/mikoo/Pictures/2024_12_17--14_09_00--2.png)
}

settings {
  encodeUrl: true
}
