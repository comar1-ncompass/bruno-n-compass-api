meta {
  name: New Request
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/dealer/getdealerlicensebyzone?page=1&dealerId=0eecbd44-fa6f-45c8-97c1-eebe7ffefa28
  body: none
  auth: inherit
}

params:query {
  page: 1
  dealerId: 0eecbd44-fa6f-45c8-97c1-eebe7ffefa28
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
