meta {
  name: Get Screen Details by ID
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/screen/getscreenbyid?screenId=34304b2e-76db-42ab-b4eb-e38542df4e73&licenseId=de5796ea-b0ea-405d-95ab-3bccde81f19c
  body: none
  auth: inherit
}

params:query {
  screenId: 34304b2e-76db-42ab-b4eb-e38542df4e73
  licenseId: de5796ea-b0ea-405d-95ab-3bccde81f19c
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ### API Endpoint: Get Screen Details by ID
  
  This endpoint retrieves comprehensive details for a specific screen, identified by its unique ID. The response includes metadata about the screen itself, its assigned screen type, template, creator, and a detailed breakdown of all content currently playing in each of its designated zones.
  
  ---
  
  #### HTTP Method
  
  `GET`
  
  ---
  
  #### Endpoint
  
  `{{baseUrl}}/api/screen/getscreenbyid`
  
  ---
  
  #### Query Parameters
  
  The following query parameters are required to fetch the screen details.
  
  - **screenId** (string, required): The unique identifier of the screen.
      
  - **licenseId** (string, required): The unique identifier of the license associated with the screen.
      
  
  ---
  
  #### Expected Response Format
  
  The response is a JSON object containing nested details about the screen and its related components.
  
  JSON
  
  ```
