meta {
  name: License Status > Assigned > Online
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/license/getall?page=1&search=&sortColumn=PiStatus&sortOrder=desc&pageSize=15&includeAdmin=false&piStatus=1&daysOfflineFrom=&daysOfflineTo=&active=true&daysInstalled=&timezone=&dealerId=&hostId=&assigned=true&pending=&online=true&isActivated=1&isFavorite=&serverVersion=&uiVersion=&piOrder=
  body: none
  auth: inherit
}

params:query {
  page: 1
  search: 
  sortColumn: PiStatus
  sortOrder: desc
  pageSize: 15
  includeAdmin: false
  piStatus: 1
  daysOfflineFrom: 
  daysOfflineTo: 
  active: true
  daysInstalled: 
  timezone: 
  dealerId: 
  hostId: 
  assigned: true
  pending: 
  online: true
  isActivated: 1
  isFavorite: 
  serverVersion: 
  uiVersion: 
  piOrder: 
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ### API Endpoint: Get All Licenses in License Status > Assigned > Online
  
  This endpoint is used to retrieve a list of licenses with specific filtering options. It allows users to filter the License Status, specifically to fetch records where the License Status is greater than 'Assigned' and 'Online'. The request supports pagination and sorting, enabling users to specify the page number, sort column, and order of the results.
  
  ### Request Parameters
  
  - **page** (integer): The page number of the results to retrieve.
      
  - **search** (string): A search term to filter the results.
      
  - **sortColumn** (string): The column by which to sort the results (e.g., `PiStatus`).
      
  - **sortOrder** (string): The order of sorting (e.g., `desc` for descending).
      
  - **pageSize** (integer): The number of results to return per page.
      
  - **includeAdmin** (boolean): Whether to include admin records in the results.
      
  - **piStatus** (integer): Filter to include licenses with a specific PI status (greater than 'Assigned' and 'Online').
      
  - **active** (boolean): Filter to include only active licenses.
      
  - **isActivated** (integer): Filter to include only activated licenses.
      
  - **isFavorite** (string): Filter to include only favorite licenses.
      
  - **online** (boolean): Filter to include only online licenses.
      
  
  ### Response Structure
  
  The response will contain a JSON object with the following structure:
  
  - **licenses** (array): A list of license objects that match the filtering criteria.
      
      - Each license object may include:
          
          - **licenseId** (string): The unique identifier for the license.
              
          - **licenseKey** (string): The key associated with the license.
              
          - **macAddress** (string): The MAC address associated with the license.
              
          - **isRegistered** (integer): Registration status of the license.
              
          - **isActivated** (integer): Activation status of the license.
              
          - Additional fields related to the license details.
              
  - **paging** (object): Information about pagination.
      
      - **hasPreviousPage** (boolean): Indicates if there is a previous page.
          
      - **hasNextPage** (boolean): Indicates if there is a next page.
          
      - **page** (integer): Current page number.
          
      - **totalEntities** (integer): Total number of entities available.
          
  - **totalCounts** (object): Summary counts of licenses based on various statuses.
      
      - **total** (integer): Total number of licenses.
          
      - **totalOnline** (integer): Total number of online licenses.
          
      - **totalOffline** (integer): Total number of offline licenses.
          
      - **totalInActive** (integer): Total number of inactive licenses.
          
      - **totalUnAssigned** (integer): Total number of unassigned licenses.
          
  
  This endpoint is essential for managing and monitoring license statuses effectively.
  
