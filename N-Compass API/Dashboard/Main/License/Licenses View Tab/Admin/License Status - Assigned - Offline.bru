meta {
  name: License Status > Assigned > Offline
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/license/getall?page=1&search=&sortColumn=TimeIn&sortOrder=desc&pageSize=15&includeAdmin=false&piStatus=0&daysOfflineFrom=&daysOfflineTo=&active=true&daysInstalled=&timezone=&dealerId=&hostId=&assigned=true&pending=&online=false&isActivated=1&isFavorite=&serverVersion=&uiVersion=&piOrder=
  body: none
  auth: inherit
}

params:query {
  page: 1
  search: 
  sortColumn: TimeIn
  sortOrder: desc
  pageSize: 15
  includeAdmin: false
  piStatus: 0
  daysOfflineFrom: 
  daysOfflineTo: 
  active: true
  daysInstalled: 
  timezone: 
  dealerId: 
  hostId: 
  assigned: true
  pending: 
  online: false
  isActivated: 1
  isFavorite: 
  serverVersion: 
  uiVersion: 
