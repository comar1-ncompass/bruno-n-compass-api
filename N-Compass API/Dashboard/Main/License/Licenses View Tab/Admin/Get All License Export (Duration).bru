script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## API Endpoint: Get All Licenses with Duration
  
  ### Request Method
  
  `GET`
  
  ### Endpoint
  
  `{{baseUrl}}/api/license/getallwithduration`
  
  ### Query Parameters
  
  - **page** (integer): Specifies the page number to retrieve. Default is `0`.
      
  - **search** (string): A search term to filter results. Default is an empty string.
      
  - **sortColumn** (string): The column by which to sort results. Default is `PiStatus`.
      
  - **sortOrder** (string): The order of sorting, either `asc` or `desc`. Default is `desc`.
      
  - **pageSize** (integer): The number of records to return per page. Default is `0`.
      
  - **includeAdmin** (boolean): Indicates whether to include admin records. Default is `false`.
      
  - **piStatus** (string): Filter by PI status. Default is an empty string.
      
  - **daysOfflineFrom** (integer): Filter licenses based on days offline from this value. Default is an empty string.
      
  - **daysOfflineTo** (integer): Filter licenses based on days offline to this value. Default is an empty string.
      
  - **active** (boolean): Filter by active status. Default is an empty string.
      
  - **daysInstalled** (integer): Filter licenses based on days installed. Default is an empty string.
      
  - **timezone** (string): Specify the timezone. Default is an empty string.
      
  - **dealerId** (string): Filter by dealer ID. Default is an empty string.
      
  - **hostId** (string): Filter by host ID. Default is an empty string.
      
  - **assigned** (boolean): Filter by assigned status. Default is an empty string.
      
  - **pending** (boolean): Filter by pending status. Default is an empty string.
      
  - **online** (boolean): Filter by online status. Default is an empty string.
      
  - **isActivated** (boolean): Filter by activation status. Default is an empty string.
      
  
  ### Expected Response Format
  
  The response will be in JSON format and includes:
  
  - **licenses** (array): An array of license objects, each containing:
      
      - `licenseId`
          
      - `licenseKey`
          
      - `hostId`
          
      - `businessName`
          
      - `macAddress`
          
      - `isActivated`
          
      - `isRegistered`
          
      - `dealerId`
          
      - `dateCreated`
          
      - Various template and status fields.
          
  - **paging** (object): Contains pagination details:
      
      - `hasPreviousPage` (boolean): Indicates if there is a previous page.
          
      - `hasNextPage` (boolean): Indicates if there is a next page.
          
      - `page` (integer): Current page number.
          
      - `pageSize` (integer): Number of records per page.
          
      - `pages` (integer): Total number of pages.
          
      - `totalEntities` (integer): Total number of entities available.
          
      - `pageStart` (integer): Starting index of the current page.
          
  
  ### Example Response
  
  ``` json
  {
    "licenses": [
      {
        "licenseId": "",
        "licenseKey": "",
        "hostId": "",
        ...
      }
    ],
    "paging": {
      "hasPreviousPage": true,
      "hasNextPage": true,
      "page": 0,
      "pageSize": 0,
      "pages": 0,
      "totalEntities": 0,
      "pageStart": 0
    }
  }
  
   ```
  
  This endpoint retrieves all licenses along with their duration information based on the provided query parameters, facilitating effective management and tracking of licenses.
}
