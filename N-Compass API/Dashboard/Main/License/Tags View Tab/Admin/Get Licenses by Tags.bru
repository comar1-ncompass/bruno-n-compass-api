meta {
  name: Get Licenses by Tags
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/license/getByTags?page=1&search=
  body: none
  auth: inherit
}

params:query {
  page: 1
  search: 
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## API Endpoint: Get Licenses by Tags
  
  ### Request Method
  
  `GET`
  
  ### Endpoint
  
  `{{baseUrl}}/api/license/getByTags`
  
  ### Query Parameters
  
  - **page** (integer): The page number to retrieve. This is used for pagination of results.
      
  - **search** (string): A search term to filter the licenses based on specific criteria.
      
  
  ### Response Format
  
  The response will be in JSON format and contains the following structure:
  
  - **licenses** (array): A list of license objects, each containing:
      
      - **licenseId** (string): Unique identifier for the license.
          
      - **licenseKey** (string): Key associated with the license.
          
      - **hostId** (string): Identifier for the host.
          
      - **macAddress** (string): MAC address of the host.
          
      - **isActivated** (integer): Activation status (0 = not activated, 1 = activated).
          
      - **isRegistered** (integer): Registration status (0 = not registered, 1 = registered).
          
      - **dealerId** (string): Identifier for the dealer.
          
      - **dateCreated** (string): Timestamp of when the license was created.
          
      - **internetSpeed** (string): Speed of the internet connection.
          
      - **internetType** (string): Type of internet connection.
          
      - **memory** (string): Memory details.
          
      - **totalStorage** (string): Total storage capacity.
          
      - **freeStorage** (string): Available storage space.
          
      - **piSocketId** (string): Identifier for the PI socket.
          
      - **piStatus** (integer): Status of the PI.
          
      - **playerSocketId** (string|null): Identifier for the player socket.
          
      - **playerStatus** (integer): Status of the player.
          
      - **alias** (string): Alias for the license.
          
      - **timeOut** (string): Timeout settings.
          
      - **dateUpdated** (string): Timestamp of the last update.
          
      - **contentsUpdated** (string): Information on when contents were updated.
          
      - **anydeskId** (string): Anydesk identifier.
          
      - **appVersion** (string): Version of the application.
          
      - **serverVersion** (string): Version of the server.
          
      - **uiVersion** (string): Version of the user interface.
          
      - **displayStatus** (integer): Status of the display.
          
      - **hostName** (string): Name of the host.
          
      - **internetInfo** (string): Information about the internet connection.
          
      - **templateName** (string): Name of the template.
          
      - **screenName** (string): Name of the screen.
          
      - **screenType** (string): Type of the screen.
          
      - **hostAddress** (string): Address of the host.
          
      - **installDate** (string): Date of installation.
          
      - **timeIn** (string): Time in settings.
          
      - **category** (string): Category of the license.
          
      - **storeHours** (string): Operating hours of the store.
          
      - **screenId** (string): Identifier for the screen.
          
      - **templateId** (string): Identifier for the template.
          
      - **screenshotUrl** (string): URL for the screenshot.
          
      - **screenshotSettings** (integer): Settings for screenshots.
          
      - **speedtestSettings** (integer): Settings for speed tests.
          
      - **displayControlSettings** (integer): Settings for display control.
          
      - **resourceSettings** (integer): Resource settings.
          
      - **bootDelay** (string|null): Delay for booting.
          
      - **installRequestDate** (string): Date of the installation request.
          
      - **timezoneName** (string): Name of the timezone.
          
      - **dealerStatus** (string): Status of the dealer.
          
      - **tags** (array): List of tags associated with the license, each containing:
          
          - **name** (string): Name of the tag.
              
          - **tagColor** (string): Color associated with the tag.
              
          - **role** (integer): Role associated with the tag.
              
  - **paging** (object): Object containing pagination details, including:
      
      - **hasPreviousPage** (boolean): Indicates if there is a previous page.
          
      - **hasNextPage** (boolean): Indicates if there is a next page.
          
      - **page** (integer): Current page number.
          
      - **pageSize** (integer): Size of the page.
          
      - **pages** (integer): Total number of pages.
          
      - **totalEntities** (integer): Total number of entities available.
          
      - **pageStart** (integer): Starting index of the current page.
          
      - **entities** (array): List of entities on the current page.
          
  
  This endpoint allows users to retrieve licenses filtered by tags, with support for pagination to manage large sets of data effectively.
}
