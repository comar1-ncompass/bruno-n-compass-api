meta {
  name: ToggleUpdate
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/license/setting/ToggleUpdate
  body: json
  auth: inherit
}

body:json {
  {
      "licenseIds": ["008e76ad-a3c8-4462-93c7-ce1486fb5651"],
      "enableUpdates": 1
  }
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
