meta {
  name: PiDownloader - Assets
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/pidownloader/assets?licenseKey={{licenseKey}}
  body: none
  auth: inherit
}

params:query {
  licenseKey: {{licenseKey}}
}

vars:pre-request {
  licenseKey: 8df3b244-a16f-4b11-89bd-03556b4c83cb
}

settings {
  encodeUrl: true
  timeout: 0
}
