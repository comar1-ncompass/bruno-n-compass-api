meta {
  name: Playlist create
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/playlists
  body: json
  auth: inherit
}

headers {
  ^User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0^
  ^Accept: application/json, text/plain, */*^
  ^Accept-Language: en-US,en;q=0.9^
  ^Accept-Encoding: gzip, deflate, br, zstd^
  ^Referer: https://suite.n-compass.online/playlists/create^
  ^Content-Type: application/json^
  ^Origin: https://suite.n-compass.online^
  ^Sec-GPC: 1^
  ^Connection: keep-alive^
  ^Cookie: __Host-session_id=A0wH-_OdEIsOjBz_wbin-3IShm_C6Y-0GEpRuUvPJH8^
  ^Sec-Fetch-Dest: empty^
  ^Sec-Fetch-Mode: cors^
  ^Sec-Fetch-Site: same-origin^
  ^Priority: u=0^
}

body:json {
  {
    "playlistName": "Test",
    "description": "Test",
    "ownerId": "8981e18a-c32c-4db8-a3db-5a9d09a4f67f",
    "metadata": "{\"visibility\":\"internal\",\"tags\":[]}",
    "contents": [
