body:form-urlencoded {
  "^^{^\^playlistName^^:^\^Test": 
}

vars:pre-request {
  playlistId: b4999394-bc81-4b4d-8a95-4fca676d7d63
}

script:post-response {
  // Parse response JSON
  let response = res.getBody();
  
  // Extract collectionId (correct field)
  let playlistId = response.data.playlistId;
  
  // Save to environment variable
  bru.setEnvVar("playlistId", playlistId);
  
  // Optional: log to console
  console.log("Saved playlistId:", playlistId);
  
  // test("Status code is 201", function () {
  //     expect(res.getStatus()).to.equal(201);
  // });
  // if broken
  test("Status code is 201 if found or 404 if not found", function () {
    expect([200, 201, 404, 400, 500]).to.include(res.getStatus()); //should be 201
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
