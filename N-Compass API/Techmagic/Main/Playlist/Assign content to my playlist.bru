meta {
  name: Assign content to my playlist
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/playlists/{{playlistId}}/contents
  body: json
  auth: inherit
}

headers {
  ^accept: application/json, text/plain, */*^
  ^accept-language: en-US,en;q=0.9^
  ^cache-control: no-cache^
  ^content-type: application/json^
  Cookie: ^__Host-session_id=GkLRMZ0WbFFIxp-UiEkxIjo2ycvQP7Ty2EHW0JNJ8vA^
  ^origin: https://dashboard-sandbox-dev.n-compass.online^
  ^pragma: no-cache^
  ^priority: u=1, i^
  ^sec-ch-ua: ^\^Not
  ^sec-ch-ua-mobile: ?0^
  ^sec-ch-ua-platform: ^\^Windows^^^
  ^sec-fetch-dest: empty^
  ^sec-fetch-mode: cors^
  ^sec-fetch-site: same-origin^
  ^user-agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36^
}

body:json {
  {
    "contentIds": [
      {
        "id": "d57e0b5b-4628-42f9-a667-7b86c3d9c2a6",
        "contentType": "media",
        "duration": 10
      }
    ]
  }
}

body:form-urlencoded {
  "^^{^\^contentIds^^:^[^{^\^id^^:^\^4b519c76-dcb4-4ea0-8ec7-59b622055e4f^^,^\^contentType^^:^\^media^^,^\^duration^^:10^}^]^}^": 
}

settings {
  encodeUrl: false
  timeout: 0
}
