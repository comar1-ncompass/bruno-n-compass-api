meta {
  name: Admin edit
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/users/{{userId}}
  body: json
  auth: inherit
}

headers {
  ^User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0^
  ^Accept: application/json, text/plain, */*^
  ^Accept-Language: en-US,en;q=0.9^
  ^Accept-Encoding: gzip, deflate, br, zstd^
  ^Referer: https://suite.n-compass.online/users/create^
  ^Content-Type: application/json^
  ^Origin: https://suite.n-compass.online^
  ^Sec-GPC: 1^
  ^Connection: keep-alive^
  ^Cookie: __Host-session_id=J3EITF-SUSEgNACm6ZN-rj_KVYqOD7g24OleYcJAbU4^
  ^Sec-Fetch-Dest: empty^
  ^Sec-Fetch-Mode: cors^
  ^Sec-Fetch-Site: same-origin^
  ^Priority: u=4^
}

body:json {
  {
    "username": "changedviaautomation@n-compass.biz"
  }
}

body:form-urlencoded {
  "^^{^\^clientType^^:^\^super_admin^^,^\^userDetails^^:^{^\^username^^:^\^test0000^@admin.com^^,^\^emailAddress^^:^\^test0000^@admin.com^^,^\^firstName^^:^\^delete": 
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
