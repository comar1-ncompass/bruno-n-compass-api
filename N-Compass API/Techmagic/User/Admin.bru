meta {
  name: Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: inherit
}

headers {
  ^User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0^
  ^Accept: application/json, text/plain, */*^
  ^Accept-Language: en-US,en;q=0.9^
  ^Accept-Encoding: gzip, deflate, br, zstd^
  ^Referer: https://suite.n-compass.online/users/create^
  ^Content-Type: application/json^
  ^Origin: https://suite.n-compass.online^
  ^Sec-GPC: 1^
  ^Connection: keep-alive^
  ^Cookie: __Host-session_id=J3EITF-SUSEgNACm6ZN-rj_KVYqOD7g24OleYcJAbU4^
  ^Sec-Fetch-Dest: empty^
  ^Sec-Fetch-Mode: cors^
  ^Sec-Fetch-Site: same-origin^
  ^Priority: u=4^
}

body:json {
  {
    "clientType": "super_admin",
    "userDetails": {
      "username": "{{templatedEmail}}",
      "emailAddress": "test0001@admin.com",
      "firstName": "delete",
      "lastName": "test",
      "contactNumber": "0000000000",
      "statusId": 1,
      "password": "Password12!@",
      "passwordConfirmation": "Password12!@",
      "profilePicture": "https://cdn.filestackcontent.com/lpPNKzXfT3GICpBY0Oqt",
      "metadata": {}
    }
  }
}

body:form-urlencoded {
  "^^{^\^clientType^^:^\^super_admin^^,^\^userDetails^^:^{^\^username^^:^\^test0000^@admin.com^^,^\^emailAddress^^:^\^test0000^@admin.com^^,^\^firstName^^:^\^delete": 
}

script:pre-request {
  // Get current date and time
  const now = new Date();
  
  // Format date and time
  const now = new Date();
  
  const timestamp = now
    .toISOString()
    .replace(/[-:T.]/g, '')
    .slice(2, 14);
  
  // Build the collection name
  const templatedEmail = `testemail${timestamp}@test.com`;
  
  // Save to environment variable
  bru.setEnvVar("templatedEmail", templatedEmail);
  
  //remove everything above when fix is made
}

script:post-response {
  // Parse response JSON
  let response = res.getBody();
  
  // Extract collectionId (correct field)
  let userId = response.data.userId;
  
  // Save to environment variable
  bru.setEnvVar("dealerUserId", userId);
  
  // Optional: log to console
  console.log("Saved dealerUserId:", userId);
  
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
