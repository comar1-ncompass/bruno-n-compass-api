meta {
  name: Bulk delete channels
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/channels/bulk-delete
  body: json
  auth: inherit
}

body:json {
  {
    "channelIds": [
      "{{channelId2}}"
    ]
  }
}

