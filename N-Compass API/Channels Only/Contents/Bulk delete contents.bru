meta {
  name: Bulk delete contents
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/contents/bulk-delete
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{bearer_token}}
}

body:json {
  {
    "contentIds": [
      "{{lastContentId}}",
      "{{secondContentId}}"
    ]
  }
}

script:post-response {
  // 1. Status code is 200 
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  // 2. Response time check
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  // 3. JSON Object check
  test("Response is valid JSON array", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody(); 
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
