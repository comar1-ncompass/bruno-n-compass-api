meta {
  name: Admin Log In
  type: http
  seq: 2
}

post {
  url: https://api-development.n-compass.online:8002/api/account/login
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "username": "francisc2@admin.com", 
      "password": "password"
  }
  
  // current temp baseUrl: https://api-development.n-compass.online:8002
}

script:post-response {
  test('Token is set', () => {
      const response = res.getBody();
      bru.setEnvVar('bearer_token', response.token);
      const tokenNow = bru.getEnvVar('bearer_token');
      expect(response.token).to.equal(tokenNow);
  });
  
  test('UserId token is set', () => {
      const response = res.getBody();
      bru.setEnvVar('dev_nctvUserId', response.userId);
      const tokenNow = bru.getEnvVar('dev_nctvUserId');
      expect(response.token).to.equal(tokenNow);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
