script:pre-request {
  function generateRandomId() {
    return "ChIJ" + Math.random().toString(36).substring(2, 18);
  }
  
  function generateUUID() {
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(
      /[xy]/g,
      function (c) {
        const r = Math.random() * 16 | 0;
        const v = c === "x" ? r : (r & 0x3 | 0x8);
        return v.toString(16);
      }
    );
  }
  
  // Unique timestamp for this test record
  const uniqueId = Date.now();
  
  // Generate unique values
  const googlePlaceId = generateRandomId();
  const licenseId = generateUUID();
  
  // Generate clearly identifiable test business name
  const businessName = `API Test Host - ${uniqueId}`;
  
  // Store variables
  bru.setVar("googlePlaceId", googlePlaceId);
  bru.setVar("licenseId", licenseId);
  bru.setVar("businessName", businessName);
  
  console.log("=================================");
  console.log("API TEST HOST CREATED");
  console.log("Business Name:", businessName);
  console.log("Google Place ID:", googlePlaceId);
  console.log("License ID:", licenseId);
  console.log("=================================");
}

settings {
  encodeUrl: false
  timeout: 0
}
