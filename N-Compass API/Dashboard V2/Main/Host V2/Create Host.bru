meta {
  name: Create Host
  type: http
  seq: 3
}

post {
  url: https://ntv360api-dev.n-compass.online/api/hosts
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer YOUR_SECRET_TOKEN
}

