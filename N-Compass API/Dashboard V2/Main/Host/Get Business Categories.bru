meta {
  name: Get Business Categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/business-categories?sortBy=categoryName&sortOrder=asc&page=1&limit=50
  body: none
  auth: inherit
}

params:query {
  sortBy: categoryName
  sortOrder: asc
  page: 1
  limit: 50
}

script:post-response {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
