meta {
  name: Dealer
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/users
  body: json
  auth: inherit
}

headers {
  ^User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:150.0) Gecko/20100101 Firefox/150.0^
  ^Accept: application/json, text/plain, */*^
  ^Accept-Language: en-US,en;q=0.9^
  ^Accept-Encoding: gzip, deflate, br, zstd^
  ^Referer: https://suite.n-compass.online/users/create^
  ^Content-Type: application/json^
  ^Origin: https://suite.n-compass.online^
  ^Sec-GPC: 1^
  ^Connection: keep-alive^
  ^Cookie: __Host-session_id=A0wH-_OdEIsOjBz_wbin-3IShm_C6Y-0GEpRuUvPJH8^
  ^Sec-Fetch-Dest: empty^
  ^Sec-Fetch-Mode: cors^
  ^Sec-Fetch-Site: same-origin^
  ^Priority: u=4^
}

body:json {
  {
    "clientType": "dealer",
    "userDetails": {
      "username": "{{templatedUsername}}",
      "emailAddress": "{{templatedEmail}}",
      "firstName": "Test ",
      "lastName": "Dealer",
      "contactNumber": "0000000000",
      "statusId": 1,
      "password": "Password12!@",
      "passwordConfirmation": "Password12!@",
      "profilePicture": "https://cdn.filestackcontent.com/RxPskDiQeCkvfcY8LJ7X",
      "metadata": "{}"
    },
    "clientInformation": {
      "businessName": "TestBusiness",
      "region": "NE",
      "state": "Pennsylvania",
      "city": "Aaronsburg",
      "alias": "Test",
      "dateActivated": "2026-05-14"
    }
  }
}

body:form-urlencoded {
  "^^{^\^clientType^^:^\^dealer^^,^\^userDetails^^:^{^\^username^^:^\^testemail^@admin.com^^,^\^emailAddress^^:^\^testemail^@admin.com^^,^\^firstName^^:^\^Test": 
}

script:pre-request {
  // Format date and time
  const now = new Date();
  
  const timestamp = now
    .toISOString()
    .replace(/[-:T.]/g, '')
    .slice(2, 14);
  
  // Build the collection name
  const templatedEmail = `testemail${timestamp}@test.com`;
  const templatedUsername = `user${timestamp}`
  
  // Save to environment variable
  bru.setEnvVar("templatedUsername", templatedUsername);
  bru.setEnvVar("templatedEmail", templatedEmail);
  
  //remove everything above when fix is made
}

script:post-response {
  // Parse response JSON
  let response = res.getBody();
  
  // Extract collectionId (correct field)
  let userId = response.data.userId;
  
  // Save to environment variable
  bru.setEnvVar("userId", userId);
  
  // Optional: log to console
  console.log("Saved dealerUserId:", userId);
  
  test("Status code is 201", function () {
    expect([200, 201]).to.include(res.getStatus()); //should be 201 only
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
