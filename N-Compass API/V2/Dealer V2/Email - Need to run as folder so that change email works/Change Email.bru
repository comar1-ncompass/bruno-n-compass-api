meta {
  name: Change Email
  type: http
  seq: 2
}

patch {
  url: https://ntv360api-dev.n-compass.online/api/dealers/eb664792-849a-4354-8847-2c23b96aefe3
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer YOUR_SECRET_TOKEN
  Content-Type: application/json
}

body:json {
  {
    "user": {
      "emailAddress": "{{newEmail}}"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
