meta {
  name: Users-Roles Get
  type: graphql
  seq: 13
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  {
    getUserRoles(queryOptions: {
      page: 1,
      limit: 10,
      sortBy: "createdAt",  # Must match the snake_case column name
      sortOrder: "DESC",
      filters: "{ \"userId\": \"1c7e0966-0b4f-4d27-83c2-45e03fc5e3da\" }"  # Stringified camelCase JSON — will be parsed server-side
    }) {
      data {
        userRoleId
        userId
        roleId
        isPrimary
        statusId
        assignedBy
        createdAt
        updatedAt
      }
      meta {
        totalCount
        page
        limit
      }
    }
  }
  
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
