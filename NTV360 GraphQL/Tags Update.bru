meta {
  name: Tags Update
  type: graphql
  seq: 89
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  # Mutation: Update an existing tag
  mutation {
    updateTag(
      tagId: "7bbb9f5f-6264-4202-b0bf-6788c1e28b5f"
      input: {
        tagLabel: "Kusog kaayo Internet"
        color: "#FF0000"
      }
    ) {
      tagId
      tagCode
      tagLabel
      tagType
      color
      description
      systemLevel
      createdBy
      createdAt
      updatedBy
      updatedAt
    }
  }
  
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
