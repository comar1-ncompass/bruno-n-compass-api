meta {
  name: Users-Roles Delete
  type: graphql
  seq: 16
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation {
      deleteUserRole(
          userRoleId: "6b4b7456-a448-4441-b445-dfc86e0077b0"
      ){
          message
      }
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
