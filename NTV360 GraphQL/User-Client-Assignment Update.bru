meta {
  name: User-Client-Assignment Update
  type: graphql
  seq: 50
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation {
    updateUserClientAssignment(
      userClientAssignmentId: "f095c14f-94bc-4fa0-8c9d-1ecdb8f2f658",
      input: {
        roleId: "9584bec5-870e-42dd-8c09-540f2e1c4196"
      }
    ) {
      userClientAssignmentId
      userId
      clientTypeId
      clientInformationId
      organizationId
      roleId
      createdBy
      updatedBy
      createdAt
      updatedAt
    }
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
