meta {
  name: Host-Location Update
  type: graphql
  seq: 78
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation {
    updateHostLocation(
      hostLocationId: "38322f9a-d13c-4d7e-9683-02cf3f2fd0b1"
      input: {
        businessName: "KKB ni Botchok"
        
    }) {
      hostLocationId
      businessName
      sourceType
      ownerId
      category
      city
      state
      region
      country
      addressLine1
      addressLine2
      contactPerson
      contactNumber
      emailAddress
      googlePlaceId
      latitude
      longitude
      zip
      boundaryId
      timezoneId
      businessHours
      metadata
      createdBy
      createdAt
      updatedBy
      updatedAt
      deletedBy
      deletedAt
    }
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
