meta {
  name: Organization Update
  type: graphql
  seq: 31
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation {
    updateOrganization(
      organizationId: "26783a6c-a325-4097-a580-a77b8ead9cfd",
      input: {
        organizationKey: "kamote_club_ph"
      }
    ) {
      organizationId
      organizationKey
      organizationName
      statusId
      createdAt
      updatedAt
      createdBy
      updatedBy
      deletedAt
      deletedBy
    }
  }
  
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
