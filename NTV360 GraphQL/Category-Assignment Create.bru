meta {
  name: Category-Assignment Create
  type: graphql
  seq: 100
}

post {
  url: {{GQL_URL}}
  body: graphql
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:graphql {
  mutation {
    createCategoryAssignment(
      input: {
        categoryId: "2ec71eb2-4734-46ca-9b62-eef177f0d7e1"
        entitySlug: "role"
        recordId: "f09518cd-d48b-412e-89a7-b4dc7eddbdab"
        createdBy: "f1e4eacb-401c-4af0-b530-a7e58431f3c9"
      }
    ) {
      categoryId
      entitySlug
      recordId
      createdBy
      createdAt
    }
  }
  
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
