              "macAddress": "d8:3a:dd:3a:2f:bf",
              "isRegistered": 1,
              "isActivated": 1,
              "dealerId": "9e75ec2b-d3f2-4f12-94a7-2e63cb483896",
              "hostId": "ffffecfd-3cf5-408e-8aea-54ddc6df4aec",
              "dateCreated": "2025-06-27T02:46:44+00:00",
              "internetType": "wlan0",
              "internetSpeed": "Slow",
