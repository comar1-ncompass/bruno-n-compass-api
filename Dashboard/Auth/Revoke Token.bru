meta {
  name: Revoke Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/account/login
  body: json
  auth: bearer
}

params:query {
  ~email: 
}

auth:bearer {
  token: {{bearer_token}}
}

body:json {
  {
      "username": "francisc@admin.com",
      "password": "password"
  }
}

script:post-response {
  test('Token is set', () => {
      const response = res.getBody();
      bru.setEnvVar('bearer_token', response.token);
      const tokenNow = bru.getEnvVar('bearer_token');
      expect(response.token).to.equal(tokenNow);
  });
}

settings {
  encodeUrl: true
}
