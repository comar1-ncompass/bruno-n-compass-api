meta {
  name: Techmagic Login
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/account/login
  body: json
  auth: bearer
}

params:query {
  ~email: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  // {
  //     "username": "test-bot@dealer-admin.com",
  //     "password": "lhnRW?324r|{"
  // }
  {
      "username": "ntv_user@tutamail.com",
      "password": "Password1!"
  }
}

script:post-response {
  test('Token is set', () => {
      const response = res.getBody();
      bru.setEnvVar('bearer_token', response.token);
      const tokenNow = bru.getEnvVar('bearer_token');
      expect(response.token).to.equal(tokenNow);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
