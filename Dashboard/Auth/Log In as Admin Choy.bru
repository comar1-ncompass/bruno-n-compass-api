meta {
  name: Log In as Admin Choy
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/account/login
  body: json
  auth: bearer
}

params:query {
  ~email: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "username": "{{choyAdmin}}",
      "password": "{{choyAdminPassword}}"
  }
}

script:post-response {
  test('Token is set', () => {
      const response = res.getBody();
      bru.setEnvVar('bearer_token', response.token);
      const tokenNow = bru.getEnvVar('bearer_token');
      expect(response.token).to.equal(tokenNow);
  });
}

settings {
  encodeUrl: true
}
