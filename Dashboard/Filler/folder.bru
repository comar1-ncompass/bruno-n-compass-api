script:pre-request {
  filler_group = "f8e3b50a-7df6-4ecf-aa9a-2b885c965a07"
  
  // Define the request to get filler content
  const getFillerContentRequest = {
      url: `https://dev-api.n-compass.online/api/filler/content/getbygroupid?id=${bru.getCollectionVar("filler_group_id")}`,
      method: 'GET',
      header: {
          // Add any required headers here, for example:
  //         // 'Authorization': `Bearer ${pm.collectionVariables.get("access_token")}`,
          'Content-Type': 'application/json'
      }
  };
  
  // // Send the request
  // // pm.sendRequest(getFillerContentRequest, (err, response) => {
  //     if (err) {
  //         console.error('Error fetching filler content:', err);
  //         return;
  //     }
      
  //     if (response.code !== 200) {
  //         console.error('API request failed with status:', response.code);
  //         console.error('Response:', response.text());
  //         return;
  //     }
      
  //     // Parse the response JSON
  //     const responseJson = response.json();
      
  //     if (!responseJson || responseJson.length === 0) {
  //         console.error('No filler content found or empty response');
  //         return;
  //     }
      
  //     // Get a random index from the array
  //     const randomIndex = Math.floor(Math.random() * responseJson.length);
      
  //     // Extract the random fillerContentId
  //     const randomFillerContentId = responseJson[randomIndex].fillerContentId;
      
  //     // Store it as a collection variable for reuse
  // //     pm.collectionVariables.set("randomFillerContentId", randomFillerContentId);
      
  //     // Log it to console to see what was selected
  //     console.log("Selected random fillerContentId:", randomFillerContentId);
  //     console.log("From", responseJson.length, "available content items");
  // });
  
  // API endpoint to fetch filler content by group ID
  const fillerGroupId = bru.getCollectionVar("filler_group_id");
  const accessToken = bru.getCollectionVar("access_token");
  
  await bru.sendRequest({
      url: `https://dev-api.n-compass.online/api/filler/content/getbygroupid?id=${fillerGroupId}`,
      method: 'GET',
      headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${accessToken}`
      }
  }, async function(err, res) {
      if (err) {
          console.error("Error fetching filler content:", err);
          return;
      }
  
      let responseData = res.data;
  
      // Filter only active content
      let activeContent = responseData.filter(item => item.Status === "A");
  
      if (activeContent.length === 0) {
          console.error("No active filler content found");
          return;
      }
  
      // ---- Random Single ----
      let randomSingle = activeContent[Math.floor(Math.random() * activeContent.length)];
      let randomFillerContentId = {
          fillerContentId: randomSingle.fillerContentId,
          type: randomSingle.type || 2,
          schedule: { type: randomSingle.type || 2 },
          duration: randomSingle.duration || 20,
          isFullScreen: randomSingle.isFullScreen || 0,
          Recurring: randomSingle.Recurring || false,
          LiveStream: randomSingle.LiveStream || 0,
          From: "",
          To: "",
          Days: "",
          AlternateWeek: randomSingle.AlternateWeek || 0,
          PlayTimeStart: "",
          PlayTimeEnd: "",
          Status: randomSingle.Status
      };
  //     pm.collectionVariables.set("randomFillerContentId", JSON.stringify([randomFillerContentId]));
  
      // ---- Random Multiple ----
      let shuffled = [...activeContent];
      for (let i = shuffled.length - 1; i > 0; i--) {
          let j = Math.floor(Math.random() * (i + 1));
          [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      let count = Math.floor(Math.random() * shuffled.length) + 1;
      let randomMultipleDTOs = shuffled.slice(0, count).map(item => ({
          fillerContentId: item.fillerContentId,
          type: item.type || 2,
          schedule: { type: item.type || 2 },
          duration: item.duration || 20,
          isFullScreen: item.isFullScreen || 0,
          Recurring: item.Recurring || false,
          LiveStream: item.LiveStream || 0,
          From: "",
          To: "",
          Days: "",
          AlternateWeek: item.AlternateWeek || 0,
          PlayTimeStart: "",
          PlayTimeEnd: "",
          Status: item.Status
      }));
  
  //     pm.collectionVariables.set("multipleFillerContentIds", JSON.stringify(randomMultipleDTOs));
  
      console.log(`Picked 1 random fillerContentId:`, randomFillerContentId);
      console.log(`Picked ${count} multiple fillerContentIds:`, randomMultipleDTOs);
  });
  
}
