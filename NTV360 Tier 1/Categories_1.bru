meta {
  name: Categories_1
  type: http
  seq: 114
}

post {
  url: {{API_URL}}/categories
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "categoryCode": "tungtung",
      "categoryName": "Sahur Tung",
      "description": "For all fruit-related entries",
      "metadata": "{\"icon\": \"🍎\"}",
      "createdBy": "f1e4eacb-401c-4af0-b530-a7e58431f3c9"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
