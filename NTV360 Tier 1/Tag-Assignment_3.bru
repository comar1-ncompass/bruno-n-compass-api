meta {
  name: Tag-Assignment_3
  type: http
  seq: 111
}

delete {
  url: {{API_URL}}/tag-assignments/e5000cdb-9139-406a-be14-6b107edfe078/user/d290f1ee-6c54-4b01-90e6-d701748f0851
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
