meta {
  name: Client-Information_2
  type: http
  seq: 47
}

patch {
  url: {{API_URL}}/client-information/3cb5d451-7ce6-4c7b-8f9e-63934c3cc338
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "businessName": "NCompass Tv 360"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
