meta {
  name: Permission_3
  type: http
  seq: 38
}

delete {
  url: {{API_URL}}/permissions/167a4e45-1e07-431b-800f-93f9a03684cf
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "statusLabel": "Online",
      "description": "Indicates that the record is active"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
