meta {
  name: Category-Assignment_3
  type: http
  seq: 121
}

delete {
  url: {{API_URL}}/category-assignments/2ec71eb2-4734-46ca-9b62-eef177f0d7e1/user/f09518cd-d48b-412e-89a7-b4dc7eddbdab
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
