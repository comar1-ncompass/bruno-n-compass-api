meta {
  name: Organization_2
  type: http
  seq: 24
}

patch {
  url: {{API_URL}}/organizations/f9f1cb9b-2443-4225-be73-13a45ae12387
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "organizationName": "Tenant 6XxX9 Corporation"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
