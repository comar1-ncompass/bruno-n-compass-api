meta {
  name: Tags_2
  type: http
  seq: 105
}

patch {
  url: {{API_URL}}/tags/48e6c59b-2b0a-43e8-b36f-b77b33465af7
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "tagLabel": "VERY FASTTTT Internet"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
