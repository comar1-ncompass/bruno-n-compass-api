meta {
  name: Client-Types_1
  type: http
  seq: 28
}

post {
  url: {{API_URL}}/client-types
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "clientTypeCode": "advertiser",
      "clientTypeName": "Advertiser Client",
      "organizationId": "5170b521-07cd-4c7a-a837-293d85ef6d70",
      "createdBy": "7b48cb65-2108-4449-991b-35190a46dcfc"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
