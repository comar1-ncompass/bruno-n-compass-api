meta {
  name: Users_2
  type: http
  seq: 5
}

delete {
  url: {{API_URL}}/users/e8d30c68-6995-4a82-8053-6d22497954aa
  body: json
  auth: inherit
}

body:json {
  {
      "username": "{{username}}",
      "emailAddress": "{{email}}",
      "firstName": "Test {{userIndex}}",
      "lastName": "User {{userIndex}}",
      "contactNumber": "1234567890",
      "statusId": 1,
      "password": "qwerty123@A",
      "passwordConfirmation": "qwerty123@A"
  }
}

script:pre-request {
  // Configure range
  let start = 1;
  let end = 50;
  
  let current = bru.getEnvVar("userIndex");
  
  if (!current) {
      current = start;
  } else {
      current = parseInt(current) + 1;
  }
  
  // Stop runner if we've reached the end
  if (current > end) {
      bru.setNextRequest(null); // halts the runner
  } else {
      bru.setEnvVar("userIndex", current);
  
      const username = `qwerty${current}`;
      const email = `${username}@example.com`;
  
      bru.setEnvVar("username", username);
      bru.setEnvVar("email", email);
  }
  
}

settings {
  encodeUrl: true
}
