meta {
  name: Dealer SC
  type: http
  seq: 2
}

get {
  url: https://ntv360api-dev.n-compass.online/api/dashboard/dealers
  body: none
  auth: inherit
}

tests {
  const body = res.getBody();
  
  test("Status code should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Total Dealers should exist", function () {
    expect(body.data.totalDealers).to.not.be.undefined;
  });
  
  test("Total Dealers overall count should be a number", function () {
    expect(body.data.totalDealers.overall).to.be.a("number");
    expect(body.data.totalDealers.overall).to.be.at.least(0);
  });
  
  test("This Week count should exist and be valid", function () {
    expect(body.data.totalDealers.thisWeek).to.not.be.undefined;
    expect(body.data.totalDealers.thisWeek).to.be.a("number");
    expect(body.data.totalDealers.thisWeek).to.be.at.least(0);
  });
  
  test("Last Week count should exist and be valid", function () {
    expect(body.data.totalDealers.lastWeek).to.not.be.undefined;
    expect(body.data.totalDealers.lastWeek).to.be.a("number");
    expect(body.data.totalDealers.lastWeek).to.be.at.least(0);
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
