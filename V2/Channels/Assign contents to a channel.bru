meta {
  name: Assign contents to a channel
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/channels/{{channelId2}}/contents
  body: json
  auth: inherit
}

body:json {
  {
    "contents": [
      {
        "contentId": "f1417ba9-8e09-48d2-b30c-2210bd2fc7dd",
        "duration": 30
      },
      {
        "contentId": "dc7cf273-7147-47a2-be51-ca5e7d79f494",
        "duration": 20
      }
    ]
  }
}

script:pre-request {
  // Get current date and time
  const now = new Date();
  // Format date and time
  const date = now.toISOString().split('T')[0]; // YYYY-MM-DD
  const time = now.toTimeString().split(' ')[0].replace(/:/g, ''); // HH-MM-SS
  // Build the collection name
  const templatedName = `API_Discovery_Channel_${date}_${time}`;
  // Save to environment variable
  bru.setEnvVar("templatedName", templatedName);
  //remove everything above when fix is made
  const testChannelName = bru.getEnvVar("templatedName")
  await bru.sendRequest({
      url: "https://dev-nctvapi2.n-compass.online/api/channels",
      method: "POST",
      headers: {
          "Content-Type": "application/json",
          "Authorization": `Bearer ${bru.getEnvVar("bearer_token")}`
      },
      data: JSON.stringify({
          "channelName": `${bru.getEnvVar("templatedName")}`,
          "description": "A channel focused on science and nature documentaries.",
          "genreIds": [
              "f5fb8536-e0f7-4277-9eef-b57834f63afb",
              "4098c48e-0724-48e6-92d0-02940f5ad58c"
          ],
          "thumbnailUrl": "https://cdn.example.com/thumbnails/discovery.png",
          "isHero": false,
          "metadata": "",
          "createdBy": "321e6547-b98c-21d3-b456-426614174000",
          "contents": [
              {
              "contentId": "65268c0b-b546-4684-ab51-8d274dd3ad4c",
              "sequenceOrder": 1,
              "duration": 30
              },
              {
              "contentId": "9c14bd34-9d13-4f19-85a4-52de47a3f920",
              "sequenceOrder": 2,
              "duration": 45
              }
          ]
      })
  }, async function(err, res) {
      if (err) {
          console.log("POST request failed:", err);
          return;
      }
  
      const response = res.data;
  
      // Extract collectionId (correct field)
      let channelId2 = response.data.channelId;
  
      // Save to environment variable
      bru.setEnvVar("channelId2", channelId2);
  });
}

script:post-response {
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  test("Response is valid JSON array", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
}
