meta {
  name: Update content by ID
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/contents/{{lastContentId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{bearer_token}}
}

body:json {
  {
    "title": "Update {{templatedContentTitle}}",
    "ownerId": "a06d4cba-01ad-4792-a3eb-3c112fe62936",
    "description": "Revised banner version used for the lobby LED wall.",
    "fileName": "summer-banner-final-v2.png",
    "fileType": "image/png",
    "fileSize": 2097152,
    "url": "https://cdn.shopify.com/s/files/1/0657/3100/2634/files/Papier-peint-dinosaure-Vallee-de-montagnes-avec-riviere.jpg?v=1708171131",
    "thumbnail": "https://cdn.shopify.com/s/files/1/0657/3100/2634/files/papier-peint-dinosaure-t-rex-colore-et-accrocheur_24c5254d-548d-475a-93de-d72199a50069.png?v=1729257527",
    "duration": 5,
    "isProtected": true,
    "isConverted": true,
    "isChannel": false,
    "metadata": "{ \"upload\": { \"provider\": \"filestack\", \"handleId\": \"file-xyz123\" } }",
    "nameConflict": "auto"
  }
}

script:pre-request {
  // Get current date and time
  const now = new Date();
  
  // Format date and time
  const date = now.toISOString().split('T')[0];
  const time = now.toTimeString().split(' ')[0].replace(/:/g, '');
  
  // Re-build the templated name to ensure it's fresh
  const templatedName = `API_Content_Update_${date}_${time}`;
  
  // Save to environment variable
  bru.setEnvVar("templatedContentTitle", templatedName);
}

script:post-response {
  // 1. Verify the update was successful
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  // 2. Verify server performance
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000)
  });
  
  // 3. Verify the structure matches our expectations
  test("Response is valid JSON array", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
}
