meta {
  name: Delete a collection-channel association
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/channel-collections/{{standalone_collectionId}}/{{standalone_channelId_B}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{bearer_token}}
}

script:post-response {
  // 1. Check if the status code is 200
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  // 2. Check if the response time is acceptable
  test("Response time is acceptable", function () {
      expect(res.getResponseTime()).to.be.below(5000);
  });
  
  // 3. Check if the response is a valid JSON object
  test("Response is valid JSON object", function () {
      expect(res.getBody()).to.exist;
      const responseJson = res.getBody();
      expect(responseJson).to.be.an('object');
  });
}

settings {
  encodeUrl: true
}
