meta {
  name: Risk Status Overview
  type: http
  seq: 5
}

get {
  url: https://ntv360api-dev.n-compass.online/api/dealers/risk-stats
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer YOUR_SECRET_TOKEN
}

tests {
  const body = res.getBody();
  
  test("Status code should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Risk Status data should exist", function () {
    expect(body.data).to.be.an("array");
    expect(body.data.length).to.be.greaterThan(0);
  });
  
  test("Risk Status counts should be valid", function () {
    body.data.forEach(function (item) {
      expect(item.month).to.be.a("number");
      expect(item.month).to.be.within(1, 12);
  
      expect(item.onTrack).to.be.a("number");
      expect(item.onTrack).to.be.at.least(0);
  
      expect(item.atRisk).to.be.a("number");
      expect(item.atRisk).to.be.at.least(0);
  
      expect(item.highRisk).to.be.a("number");
      expect(item.highRisk).to.be.at.least(0);
    });
  });
  
  test("Monthly risk counts should match weekly totals", function () {
    body.data.forEach(function (item) {
      if (!item.week) return;
  
      let onTrackTotal = 0;
      let atRiskTotal = 0;
      let highRiskTotal = 0;
  
      Object.keys(item.week).forEach(function (week) {
        onTrackTotal += item.week[week].onTrack;
        atRiskTotal += item.week[week].atRisk;
        highRiskTotal += item.week[week].highRisk;
      });
  
      expect(item.onTrack).to.equal(onTrackTotal);
      expect(item.atRisk).to.equal(atRiskTotal);
      expect(item.highRisk).to.equal(highRiskTotal);
    });
  });
  
  test("Calculate Risk Status totals", function () {
    let onTrackTotal = 0;
    let atRiskTotal = 0;
    let highRiskTotal = 0;
  
    body.data.forEach(function (item) {
      onTrackTotal += item.onTrack;
      atRiskTotal += item.atRisk;
      highRiskTotal += item.highRisk;
    });
  
    console.log("On Track Total:", onTrackTotal);
    console.log("At Risk Total:", atRiskTotal);
    console.log("High Risk Total:", highRiskTotal);
  });
}

settings {
  encodeUrl: false
  timeout: 0
}
