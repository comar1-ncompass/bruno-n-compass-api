docs {
  ### Summary Cards
  
   #### Total Dealers = Active + Inactive
             1371 = 1330 + 7 (FAILED)
    
   #### This Week = ((This Week - Last Week) / Last Week) × 100
        7.69  = ((14 - 13) / 13) × 100 (PASSED)
      
   #### Last Week = ((Last Week - Two Weeks Ago) / Two Weeks Ago) × 100
       18.18  = ((13 - 11) / 11) × 100 (PASSED)
  
}
