meta {
  name: Update Contact Number
  type: http
  seq: 4
}

patch {
  url: https://ntv360api-dev.n-compass.online/api/dealers/eb664792-849a-4354-8847-2c23b96aefe3
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer YOUR_SECRET_TOKEN
}

body:json {
  {
    "user": {
      "contactNumber": "{{uniqueId}}"
    }
  }
}

script:pre-request {
  const uniqueId = Date.now().toString().slice(-10);
  
  bru.setVar("uniqueId", uniqueId);
}

settings {
  encodeUrl: false
  timeout: 0
}
